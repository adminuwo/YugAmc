# ==============================================================================
# YUG AMC Monorepo - Root Environment Variables Template
# Copy this file to .env at the monorepo root or configure within Yugamc-backend/.env
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=8080

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/yugamc_db?retryWrites=true&w=majority

# Security Keys
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
SUPER_ADMIN_API_KEY=your_super_admin_api_key_string
SUPER_ADMIN_WEBHOOK_SECRET=your_super_admin_webhook_hmac_secret_string

# Admin Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$10$YourBcryptPasswordHashPlaceholderHere

# Email Configuration
EMAIL_USER=your_smtp_email_user@example.com
EMAIL_PASS=your_smtp_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Google Cloud Platform
GCP_PROJECT_ID=your_gcp_project_id
GCS_BUCKET_NAME=your_gcs_bucket_name
GOOGLE_LOCATION=asia-south1
GEMINI_MODEL=gemini-2.5-flash

# Frontend (Vite)
VITE_API_URL=http://localhost:8080/api
VITE_UNIFIED_BACKEND_API=https://uwo24.com/api
VITE_UWO_API_KEY=your_uwo_application_key_here

