# ==============================================================================
# YUG AMC Frontend - Environment Variables Template
# Copy this file to .env and configure for your environment
# NEVER EXPOSE PRIVATE KEYS OR SERVER SECRETS IN FRONTEND VARIABLES
# ==============================================================================

# Centralized API Base URL for YugAMC Backend Services
# In Local Dev: Leave empty or use http://localhost:8080/api (or /api via Vite proxy)
# In Production: Leave empty if served from Express backend, or your custom domain URL
VITE_API_URL=http://localhost:8080/api

# Central UWO SSO Backend API Endpoint (Optional)
VITE_UNIFIED_BACKEND_API=https://uwo24.com/api

# UWO SSO Application Key (Optional, for client-side SSO modal if enabled)
VITE_UWO_API_KEY=your_uwo_application_key_here
