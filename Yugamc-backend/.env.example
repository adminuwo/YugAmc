# ==============================================================================
# YUG AMC Backend - Environment Variables Template
# Copy this file to .env and replace placeholders with your actual values
# NEVER COMMIT THE REAL .env FILE TO VERSION CONTROL
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=8080

# MongoDB Database Connection
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/yugamc?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/yugamc_db?retryWrites=true&w=majority

# Authentication & Cryptographic Secrets
# Generate a strong 256-bit secret with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Super Admin API Key & Webhook Security
SUPER_ADMIN_API_KEY=your_super_admin_api_key_string
SUPER_ADMIN_WEBHOOK_SECRET=your_super_admin_webhook_hmac_secret_string
SUPER_ADMIN_WEBHOOK_URL=https://your-central-platform.example.com/api/webhook
SUPER_ADMIN_PLATFORM_ID=yugamc-id

# Admin Dashboard Authentication Credentials
ADMIN_USERNAME=admin
# Provide either ADMIN_PASSWORD_HASH (recommended, bcrypt hash) or ADMIN_PASSWORD
# Generate hash with: npx bcrypt-cli hash "YourPasswordHere" 10
ADMIN_PASSWORD_HASH=$2b$10$YourBcryptPasswordHashPlaceholderHere
ADMIN_PASSWORD=your_admin_dashboard_password

# Nodemailer / SMTP Email Service Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your_smtp_email_user@example.com
EMAIL_PASS=your_smtp_app_password

# Google Cloud Platform & Storage
GCP_PROJECT_ID=your_gcp_project_id
GCS_BUCKET_NAME=your_gcs_bucket_name

# Vertex AI Settings (Optional overrides)
GOOGLE_LOCATION=asia-south1
GEMINI_MODEL=gemini-2.5-flash

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com
